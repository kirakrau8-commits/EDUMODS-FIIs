# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Database (Project ID: yhqoufgcoajcjoybhvbc)
# Configure these in Vercel Environment Variables or local .env
VITE_SUPABASE_URL="https://yhqoufgcoajcjoybhvbc.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# SEGREDOS EXCLUSIVOS DO SERVIDOR (NUNCA EXPOR COM PREFIXO VITE_ NO FRONTEND)
# Chave Service Role do Supabase para salvar/ler fii_push_subscriptions com segurança no servidor
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Chaves VAPID para Web Push em Segundo Plano (Gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:contato@edumods.com.br"

# Segredo opcional para proteger chamadas externas ao endpoint /api/cron/monitor na Vercel
CRON_SECRET="your-cron-secret-key"

# Token opcional da BRAPI no servidor para atualização automática de cotações via Cron
BRAPI_TOKEN="your-optional-brapi-token"
